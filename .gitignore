# Node.js dependencies
node_modules/

# Dependency lock files (optional to ignore)
# Uncomment if you *don't* want to track these
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by testing tools
coverage/

# Test result output
test-output/
test-results/

# Optional npm cache directory
.npm/

# Environment variables
.env
.env.*.local

# VS Code settings
.vscode/

# OS system files
.DS_Store
Thumbs.db

# Build output (optional, if your app compiles files)
dist/
build/

# Debugger configs
node-inspector.js

# TypeScript cache
*.tsbuildinfo

# ESLint cache
.eslintcache

# Logs from k6 (optional)
k6-tests/results/

# PM2 logs and dumps (if used)
pids/
*.log
*.out
*.err
dump.pm2

# IDE files
.idea/
*.sublime-project
*.sublime-workspace
